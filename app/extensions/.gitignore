!README
!.gitignore
!/.vsls.json

# Dev tooling files generated by `composer install` (upstream BlueSpice
# extension configs, not HDP-authored). These are never tracked and only
# create noise in `git status` after setup.sh runs.
.eslintrc.json
.eslintignore
.stylelintrc.json
.phpcs.xml
**/.phpcs.xml
.gitreview
**/.gitreview
.phan/
.editorconfig
**/.editorconfig
Gruntfile.js
phpunit.xml.dist
.travis.yml
**/.travis.yml
.svgo.config.js
.github/
**/.github/
.gitmodules
**/.gitmodules
.gitattributes
**/.gitattributes
jsduck.json
.dockerignore
**/.dockerignore

# Test directories from upstream (only Mermaid tests are tracked)
tests/
!Mermaid/tests/

# Additional i18n language files generated by composer refresh
**/i18n/az.json
**/i18n/bo.json
**/i18n/kea.json
**/i18n/ku-latn.json
**/i18n/hil.json
**/i18n/lkt.json
**/i18n/pa.json
**/i18n/pl.json
**/i18n/ps.json
**/i18n/sjd.json
**/i18n/sk.json
**/i18n/so.json

# Startpage content generated by composer
**/data/Content/Startpage_*/
