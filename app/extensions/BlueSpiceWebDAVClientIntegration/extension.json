{
	"name": "BlueSpiceWebDAVClientIntegration",
	"version": "4.5.2",
	"author": "[mailto:vogel@hallowelt.com Robert Vogel (Hallo Welt! GmbH)]",
	"url": "https://en.wiki.bluespice.com/wiki/Reference:BlueSpiceWebDAVClientIntegration",
	"descriptionmsg": "bs-webdav-ci-desc",
	"type": "bluespice",
	"license-name": "GPL-3.0-only",
	"attributes": {
		"BlueSpiceFoundation": {
			"Extensions": {
				"BlueSpiceWebDAVClientIntegration": {
					"className": "\\BlueSpice\\WebDAV\\ClientIntegration\\Extension",
					"extPath": "/BlueSpiceWebDAVClientIntegration",
					"package": "BlueSpice Pro"
				}
			}
		}
	},
	"requires": {
		"MediaWiki": ">= 1.39.0",
		"extensions": {
			"BlueSpiceFoundation": ">= 4.3"
		}
	},
	"callback": "\\BlueSpice\\WebDAV\\ClientIntegration\\Extension::onRegistration",
	"APIModules": {
		"bs-filehistory-store": "BSApiFileHistoryStore",
		"bs-file-tasks": "BSApiFileTasks"
	},
	"MessagesDirs": {
		"BlueSpiceWebDAVClientIntegration": [
			"i18n"
		]
	},
	"AutoloadNamespaces": {
		"BlueSpice\\WebDAV\\ClientIntegration\\": "src/"
	},
	"AutoloadClasses": {
		"WebDAVClientIntegrationHooks": "includes/WebDAVClientIntegrationHooks.php",
		"BSApiFileHistoryStore": "includes/api/BSApiFileHistoryStore.php",
		"BSApiFileTasks": "includes/api/BSApiFileTasks.php"
	},
	"ResourceModules": {
		"ext.bluespice.webDAVClientIntegration": {
			"scripts": "ext.bluespice.webDAVClientIntegration.js",
			"messages": [
				"bs-webdav-ci-edit-with",
				"bs-webdav-ci-show-history",
				"bs-webdav-ci-ms-word",
				"bs-webdav-ci-ms-excel",
				"bs-webdav-ci-ms-powerpoint",
				"bs-webdav-ci-zip",
				"bs-webdav-ci-generic",
				"bs-webdav-ci-filehistory",
				"bs-webdav-ci-filehistory-timestamp",
				"bs-webdav-ci-filehistory-size",
				"bs-webdav-ci-filehistory-user",
				"bs-webdav-ci-cannot-open-file",
				"bs-webdav-ci-file-locked-title",
				"bs-webdav-ci-file-locked"
			],
			"dependencies": [
				"ext.bluespice"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "BlueSpiceWebDAVClientIntegration/resources"
	},
	"config_prefix": "bsg",
	"config": {
		"WebDAVCIClientApps": {
			"value": {
				"bs-webdav-ci-ms-word": {
					"icon": "icon-file-word",
					"extensions": ["doc", "docx", "dot", "dotx", "rtf", "docm", "dotm", "odt" ],
					"protocol": "ms-word"
				},
				"bs-webdav-ci-ms-excel": {
					"icon": "icon-file-excel",
					"extensions":[ "xls", "xlsx", "csv", "tsv", "xlsm" ],
					"protocol": "ms-excel"
				},
				"bs-webdav-ci-ms-powerpoint": {
					"icon": "icon-file-powerpoint",
					"extensions": [ "ppt", "pptx" ],
					"protocol": "ms-powerpoint"
				},
				"bs-webdav-ci-archive": {
					"icon": "icon-file-zip",
					"extensions": [ "zip" ]
				},
				"bs-webdav-ci-generic": {
					"icon": "icon-file"
				},
				"@Not yet supported!": "",
				"@bs-webdav-ci-ms-visio": {
					"icon": "icon-file-visio",
					"extensions": [],
					"protocol": "ms-visio"
				},
				"@bs-webdav-ci-ms-access": {
					"icon": "icon-file-access",
					"extensions": [],
					"protocol": "ms-access"
				},
				"@bs-webdav-ci-ms-project": {
					"icon": "icon-file-project",
					"extensions": [],
					"protocol": "ms-project"
				},
				"@bs-webdav-ci-ms-publisher": {
					"icon": "icon-file-publisher",
					"extensions": [],
					"protocol": "ms-publisher"
				},
				"@bs-webdav-ci-ms-spd": {
					"icon": "icon-file-spd",
					"extensions": [],
					"protocol": "ms-spd"
				},
				"@bs-webdav-ci-ms-infopath": {
					"icon": "icon-file-infopath",
					"extensions": [],
					"protocol": "ms-infopath"
				}
			}
		}
	},
	"Hooks": {
		"BeforePageDisplay": "WebDAVClientIntegrationHooks::onBeforePageDisplay",
		"BsContextMenuGetItems": "WebDAVClientIntegrationHooks::onBsContextMenuGetItems"
	},
	"load_composer_autoloader": true,
	"manifest_version": 2
}
