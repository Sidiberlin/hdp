# =====================================================
# BlueSpice HDP Edition — .gitignore
# =====================================================

# Secrets — NEVER commit these
.env
*.env.local
.claude-brief.md

# Docker volumes / data (bind-mounted, not tracked)
mediawiki_data/
mariadb_data/
opensearch_data/
haystack_models/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# Editor / OS cruft
.DS_Store
*.swp
*~

# Session-local scratch (subagent handoff notes, temporary debug scripts,
# superseded early drafts — not part of the published project)
AGENT_BRIEFING.md
CHANGES.md
CHATBOT_FIX_PLAN.md
DEBRIEFING.md
HAYSTACK_FIX_PLAN.md
INGESTION_PIPELINE_PLAN.md
DOCKER_SETUP.md
.claude-qa-briefing.md
.claude/

# Logs
*.log

# MediaWiki generated config (contains live DB password + secret keys,
# generated by setup.sh's install.php run — NEVER commit this)
app/LocalSettings.php
app/vendor/

# MediaWiki runtime cache/state (regenerated automatically; can contain
# real user/session data via SQLite job queue and l10n caches — NEVER commit)
app/cache/

# Tool-generated state (not authored content)
docs/.codewiki-state.json
.gstack/
