# .dockerignore — reduce Docker build context size
# Excludes files not needed inside the container images

# Git
.git/
.gitignore
.gitattributes

# Documentation (not needed in images)
*.md
docs/
README-DOCKER.md

# Dev / CI artifacts
.claude/
.claude-qa-briefing.md
CLAUDE.md
AGENTS.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
hdp-publication-readiness-report.md

# Docker volumes (bind-mounted at runtime, never baked into images)
mediawiki_data/
mariadb_data/
opensearch_data/
haystack_models/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/

# Editor / OS
.DS_Store
*.swp
*~

# Secrets. Same coverage as .gitignore, and for the same reason: `.env` alone
# was too narrow, because a working copy on the build box can hold siblings
# like `.env.bak-preexisting` with live credentials in them. Those are
# untracked, so they never reach the image via git — but they do sit in the
# build context, which is what these lines are about. No Dockerfile COPYs
# `.env.example`, so it is excluded here too rather than re-included.
.env
.env.*
*.env
*.env.local

# Tests. Bind-mounted read-only at run time by scripts/ci/pytest.sh, never
# COPY'd, so they have no business inflating the build context.
tests/
pytest.ini
.pytest_cache/
