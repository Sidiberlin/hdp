@@ -37,8 +37,14 @@
 	var x = document.getElementsByClassName( "smw-subtab" );
 	var i;
 
+	// HDP: backport of upstream SMW 7.0.0 (CVE-2025-61682). Reads the
+	// data-mw-subtab attribute HtmlTabs.php now writes: data-mw-* is reserved
