# =====================================================
# BlueSpice HDP Edition — Docker Configuration Template
# =====================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Or let ./install.sh do it: the wizard writes every variable below from
# answers to questions, generates the four passwords, and never touches an
# existing .env without backing it up to .env.bak first.
#
# SECRETS: this project supports two ways to provide secrets (passwords,
# API keys). Use whichever fits you:
#
#   1. Infisical (recommended for teams/production) — fill in the
#      HDP_INFISICAL_* block below. At container start, infisical-loader.sh
#      fetches every secret whose name starts with HDP_ from your Infisical
#      project and injects it into the environment, overriding anything
#      set in this file.
#   2. Plain .env fallback (fine for local dev / no Infisical) — just set
#      the *_PASSWORD / *_API_KEY / *_TOKEN variables directly below. If
#      HDP_INFISICAL_CLIENT_ID/SECRET are left blank, infisical-loader.sh skips
#      itself entirely and these plaintext values are used as-is.
#
# Either way, .env is gitignored — never commit real values in it.

# =====================
# Infisical Secret Manager (OPTIONAL — leave blank to use plaintext .env fallback)
# =====================
# Machine identity credentials from your Infisical project.
# Create a Machine Identity in Infisical → Settings → Machine Identities.
HDP_INFISICAL_URL=https://your-infisical-instance.example.com
HDP_INFISICAL_PROJECT_ID=
HDP_INFISICAL_CLIENT_ID=
HDP_INFISICAL_CLIENT_SECRET=

# Environment slug, not a credential. The blank line above is deliberate:
# secret scanners match `..._CLIENT_SECRET=` across the newline and report the
# next assignment as its value, so keeping a non-assignment line between them
# removes a false positive at source instead of suppressing it.
HDP_INFISICAL_ENV=prod

# =====================
# LLM Configuration
# =====================
# HDP_LLM_BASE_URL / HDP_LLM_MODEL are non-secret (endpoint + model name).
# HDP_LLM_API_KEY is a secret: set it here as a plaintext fallback, or
# (recommended) store it in Infisical as HDP_LLM_API_KEY and leave this blank.
#
# ⚠️ If you use Infisical: infisical-loader.sh fetches EVERY secret whose
# name starts with HDP_, not just credentials — so if HDP_LLM_BASE_URL or
# HDP_LLM_MODEL also exist as Infisical secrets, THEY WIN over the values
# below on every container start. Either keep these two as pure .env
# config (don't create matching Infisical secrets), or set them in both
# places consistently. This is the single most common source of "I changed
# .env but the container is still using the old provider" confusion.
#
# Any OpenAI-compatible chat completions endpoint works:
#   OpenAI:        https://api.openai.com/v1              model: gpt-4o
#   z.ai / GLM:     https://api.z.ai/api/coding/paas/v4     model: glm-4.5-air
#   Nebius:        https://api.studio.nebius.ai/v1         model: Qwen/Qwen3-235B-A22B-Instruct-2507
HDP_LLM_BASE_URL=https://api.openai.com/v1
HDP_LLM_MODEL=gpt-4o
HDP_LLM_API_KEY=

# =====================
# Embedding Provider Configuration
# =====================
# Controls BOTH the live RAG pipeline's query-time embedder AND the
# ingest_hdp_wiki.py batch ingestion script's document embedder.
# Three modes — pick one via HDP_EMBEDDING_PROVIDER:
#
#   local (DEFAULT, zero extra config)
#     Runs sentence-transformers in-container on CPU (or GPU if
#     HAYSTACK_DEVICE=gpu). This is what upstream BlueSpice HDP ships with.
#     No other HDP_EMBEDDING_* variables needed — just leave them blank.
#
#   remote
#     Points the pipeline at any OpenAI-compatible embeddings API — e.g.
#     a self-hosted Text-Embeddings-Inference (TEI) server, or a commercial
#     embeddings API. Requires HDP_EMBEDDING_BASE_URL and HDP_EMBEDDING_MODEL;
#     HDP_EMBEDDING_API_KEY only if your endpoint requires auth.
#     Recommended for production once you have a dedicated GPU embedding
#     server — much faster than "local" on constrained hosts.
#
#   hf_space  (ingestion / testing ONLY — not usable in docker-compose here)
#     Embeds via a HuggingFace ZeroGPU Gradio Space through gradio_client.
#     Useful for a one-off fast bulk re-index (~75x faster than CPU) without
#     provisioning your own GPU. NOT valid for HDP_EMBEDDING_PROVIDER in this
#     .env — the live pipeline entrypoint rejects it (Spaces cold-start and
#     rate-limit unpredictably, unacceptable for live user queries). Instead,
#     run it as a one-off:
#       docker compose exec haystack python3 ingest_hdp_wiki.py --provider hf_space
#     with HDP_EMBEDDING_HF_SPACE_ID / HDP_EMBEDDING_HF_TOKEN set below (or
#     passed via -e on that exec command). See docs/embedding-providers.md
#     for how to deploy your own minimal embedding Space.
#
HDP_EMBEDDING_PROVIDER=local
HDP_EMBEDDING_MODEL=mixedbread-ai/deepset-mxbai-embed-de-large-v1
HDP_EMBEDDING_DIM=1024
# ⚠️ Same Infisical-shadowing caveat as HDP_LLM_* above applies here.

# Only used when HDP_EMBEDDING_PROVIDER=remote:
HDP_EMBEDDING_BASE_URL=
HDP_EMBEDDING_API_KEY=

# Only used when running ingest_hdp_wiki.py --provider hf_space manually:
HDP_EMBEDDING_HF_SPACE_ID=
HDP_EMBEDDING_HF_TOKEN=

# =====================
# Wiki Server (non-secret)
# =====================
MW_DOCKER_PORT=8080
MW_LANG=de
MW_SITENAME=BlueSpice HDP
# The base URL MediaWiki uses for all internal links and redirects.
# Default (http://localhost:<port>) works for single-user local testing.
# Set to the host IP or hostname if the wiki should be reachable from
# other machines in your LAN — otherwise logins and redirects will
# send browsers to their own localhost and fail.
#   Example: MW_SERVER=http://192.168.1.50:8080
#            MW_SERVER=https://wiki.example.com
# Applied at install time by setup.sh and re-read on every request by
# settings.d/005-Server.php, so changing it on an existing install takes
# effect after a container restart — no reinstall, no editing the generated
# LocalSettings.php.
MW_SERVER=http://localhost:8080

# FPM user: master starts as root (UID 0) to spawn www-data workers
MW_DOCKER_UID=0
MW_DOCKER_GID=0

# =====================
# Haystack (non-secret)
# =====================
# Each names one port, the same number inside the container and on the host:
# HAYHOOKS_PORT is the hayhooks admin/deploy API, HDP_PDF_PORT the RAG query
# API that chatbot-proxy calls. Both are threaded through the container
# environment, the healthcheck and chatbot-proxy's HAYHOOKS_URL, so changing
# one here moves the service, not just the published port.
HAYHOOKS_PORT=1416
HDP_PDF_PORT=1417

# cpu | gpu — which PyTorch the haystack image carries. This is not a runtime
# switch on its own: the CPU-only and CUDA wheels are chosen when the image is
# built, so setting gpu here also needs one of the two GPU compose overrides,
# which is what actually reserves the device.
#
#   pre-built:      -f docker-compose.yml -f docker-compose.prod-gpu.yml
#                   (pulls ghcr.io/sidiberlin/hdp-haystack:<tag>-gpu)
#   from source:    -f docker-compose.yml -f docker-compose.gpu.yml  ... --build
#
# Never combine those two files, or either with docker-compose.prod.yml — see
# README-DOCKER.md "GPU inference". install.sh picks the right one for you.
HAYSTACK_DEVICE=cpu

# cu124 | cu118 — which CUDA build of PyTorch goes into the image. Read only
# when HAYSTACK_DEVICE=gpu; the CPU stage pins its own CPU-only wheels and
# ignores this.
#
# NVIDIA drivers are backward compatible but not forward compatible: a newer
# driver runs an older CUDA runtime, never the other way round. cu124 wheels
# therefore need a driver that supports CUDA 12.4 or newer, and on anything
# older they fail at model load with
#
#   CUDA driver version is insufficient for CUDA runtime version
#
# which surfaces as a haystack container that builds, starts, and then never
# embeds anything. Check the ceiling with `nvidia-smi` — its header prints
# "CUDA Version: 12.4", meaning the highest CUDA this driver supports, not the
# toolkit you have installed:
#
#   CUDA 12.4 or newer   ->  cu124   (also what the published -gpu image is)
#   CUDA 11.8 – 12.3     ->  cu118   (works on every 12.x driver too)
#   older than CUDA 11.8 ->  no supported GPU build; use HAYSTACK_DEVICE=cpu
#                            or update the driver
#
# cu118 exists only as a from-source build — the published -gpu image is cu124
# — so it needs `-f docker-compose.yml -f docker-compose.gpu.yml ... --build`,
# not the prod-gpu override. install.sh detects the driver, writes this line
# and picks that path for you. Changing it later means a rebuild, not just a
# restart.
HAYSTACK_CUDA_VERSION=cu124

# Host interface the two haystack ports bind to. Defaults to loopback because
# NEITHER PORT IS AUTHENTICATED: :1416 is the hayhooks admin API (its
# /deploy-yaml and /deploy_files endpoints load caller-supplied pipeline code
# into the container as root — remote code execution), and :1417 is the RAG
# query API (unmetered LLM spend plus read access to every indexed wiki page,
# bypassing the wiki login). Nothing in the stack needs them from the host —
# chatbot-proxy talks to haystack over the compose network. Only widen this
# (e.g. HDP_BIND_ADDR=0.0.0.0) behind a reverse proxy that authenticates.
# HDP_BIND_ADDR=127.0.0.1

# =====================
# Periodic re-ingest scheduler (optional — on by default, idle until the
# first ingestion; see README-DOCKER.md's "Running / Re-running Ingestion")
# =====================
# The ingest-scheduler service runs `ingest_hdp_wiki.py --missing-only` on a
# timer so the chatbot's index does not drift behind wiki edits. It never
# performs the initial bulk ingest itself — it waits until OpenSearch is up
# AND hdp_wiki already has documents, logging once per state change until
# then. All three are non-empty on purpose, so `update.sh` auto-appends them
# on upgrade (existing installs get the scheduler without being asked).
#
#   HDP_INGEST_INTERVAL_MIN   — minutes between cycles. 0 disables the
#                                scheduler (it stays up, idle, rather than
#                                exiting or crash-looping).
#   HDP_INGEST_MAX_PAGES      — cap on pages indexed per cycle, applied after
#                                classification. Bounds a single cycle's CPU
#                                cost when something (a DB restore, a mass
#                                import) hands the scheduler an unusually
#                                large batch; the rest catches up over
#                                following cycles.
#   HDP_INGEST_BACKOFF_MAX_MIN — ceiling for the exponential backoff a failed
#                                cycle (or a failed preflight) doubles into.
#                                A lock held by a concurrent ingestion is not
#                                a failure and does not back off.
HDP_INGEST_INTERVAL_MIN=5
HDP_INGEST_MAX_PAGES=25
HDP_INGEST_BACKOFF_MAX_MIN=60

# =====================
# Ingestion API (optional — OFF until HDP_INGEST_API_KEY is set; see
# README-DOCKER.md's "Ingestion API")
# =====================
# POST /v1/ingest/pages on the haystack container's :1417 (same loopback-only
# port as the RAG query API — see HDP_BIND_ADDR above) lets an external tool
# write wiki pages and have them indexed in one authenticated call. Empty
# HDP_INGEST_API_KEY means the route answers 503 — fail closed, never open
# because unconfigured. Generate a key the same way as the other secrets:
#   openssl rand -hex 16
HDP_INGEST_API_KEY=
# Bot account the API writes as (see docker/setup.sh — created by setup.sh
# when this password is set). Falls back to the wiki Admin account with a
# WARNING when this is empty, so an upgrade that never sets it still works.
HDP_INGEST_BOT_USER=HDPIngestBot
HDP_INGEST_BOT_PASSWORD=
# Limits (defaults shown; uncomment to override):
# HDP_INGEST_API_MAX_PAGES=50
# HDP_INGEST_API_RATE_PER_MIN=6
# Comma-separated allow-list. Empty (default) means any category is
# accepted — set this once you want a 403 to mean something.
# HDP_INGEST_ALLOWED_CATEGORIES=

# =====================
# Container memory limits (optional — sensible defaults apply if unset)
# =====================
# Override any of these if your host has more/less RAM than the defaults
# assume, or if OpenSearch/haystack get OOM-killed under heavier load.
# (These are read directly by docker-compose.yml, not by the containers —
# so the Infisical-shadowing caveat above does NOT apply to these.)
# HDP_HAYSTACK_MEM_LIMIT=3g
# HDP_OPENSEARCH_MEM_LIMIT=1536m
# HDP_MARIADB_MEM_LIMIT=1g
# HDP_MEDIAWIKI_MEM_LIMIT=1g
# HDP_MEDIAWIKI_WEB_MEM_LIMIT=512m
# HDP_JOBRUNNER_MEM_LIMIT=512m
# HDP_CHATBOT_PROXY_MEM_LIMIT=256m
# HDP_INGEST_SCHEDULER_MEM_LIMIT=2g
#
# Bump HDP_HAYSTACK_MEM_LIMIT to 4g if you enable the ingestion API with
# HDP_EMBEDDING_PROVIDER=local — a second copy of the ~1.3 GB embedding model
# can land in the same process that serves RAG queries while a request is
# indexing pages. HDP_EMBEDDING_PROVIDER=remote removes this cost entirely.

# =====================
# Wiki base images (optional — leave unset unless you mirror them yourself)
# =====================
# The defaults in docker-compose.yml pull the three MediaWiki base images from
# docker-registry.wikimedia.org. Set these only if you keep your own copies —
# behind a proxy, in an air-gapped network, or as CI does (see
# scripts/ci/mirror-images.sh). A wrong value here boots the wrong wiki.
# HDP_MEDIAWIKI_IMAGE=docker-registry.wikimedia.org/dev/bookworm-php83-fpm:1.0.0
# HDP_MEDIAWIKI_WEB_IMAGE=docker-registry.wikimedia.org/dev/bookworm-apache2:1.0.1
# HDP_JOBRUNNER_IMAGE=docker-registry.wikimedia.org/dev/bookworm-php83-jobrunner:1.0.0

# =====================
# Database / Wiki / Search Secrets
# =====================
# Store these in Infisical (recommended), or set plaintext values here as
# a fallback. HDP_OPENSEARCH_PASSWORD in particular MUST be set here even
# if you use Infisical for everything else — Docker Compose needs it to
# create the OpenSearch container before any Infisical-aware process runs.
#
#   HDP_DB_ROOT_PASSWORD     — MariaDB root password
#   HDP_DB_PASSWORD          — MariaDB bluespice user password
#   HDP_ADMIN_PASSWORD       — Wiki admin account password
#                               (Minimum 10 characters — MediaWiki requirement)
#   HDP_OPENSEARCH_PASSWORD  — OpenSearch admin password
#                               (8+ chars, upper+lower+number+special char)
#                               ⚠️ OpenSearch ALSO runs a zxcvbn password-
#                               strength check beyond the character-class rules
#                               above. Common leetspeak patterns like
#                               "Adm1nPassw0rd!" will be REJECTED despite
#                               meeting all stated rules. Use a strong random
#                               password instead:
#                                 openssl rand -hex 16
HDP_DB_ROOT_PASSWORD=
HDP_DB_PASSWORD=
HDP_ADMIN_PASSWORD=
HDP_OPENSEARCH_PASSWORD=

# If using Infisical, create the secrets above via the dashboard, or the CLI:
#   infisical_set_secret "HDP_DB_ROOT_PASSWORD" "$(openssl rand -hex 16)"
#   infisical_set_secret "HDP_DB_PASSWORD" "$(openssl rand -hex 16)"
#   infisical_set_secret "HDP_ADMIN_PASSWORD" "$(openssl rand -hex 16)"
#   infisical_set_secret "HDP_OPENSEARCH_PASSWORD" "Hdp-$(openssl rand -hex 4)-26!"
#   infisical_set_secret "HDP_LLM_API_KEY" "sk-..."
