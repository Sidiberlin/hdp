# =====================================================
# BlueSpice HDP Edition — Docker Configuration Template
# =====================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# SECRETS: this project supports two ways to provide secrets (passwords,
# API keys). Use whichever fits you:
#
#   1. Infisical (recommended for teams/production) — fill in the
#      HDP_INFISICAL_* block below. At container start, infisical-loader.sh
#      fetches every secret whose name starts with HDP_ from your Infisical
#      project and injects it into the environment, overriding anything
#      set in this file.
#   2. Plain .env fallback (fine for local dev / no Infisical) — just set
#      the *_PASSWORD / *_API_KEY / *_TOKEN variables directly below. If
#      HDP_INFISICAL_CLIENT_ID/SECRET are left blank, infisical-loader.sh skips
#      itself entirely and these plaintext values are used as-is.
#
# Either way, .env is gitignored — never commit real values in it.

# =====================
# Infisical Secret Manager (OPTIONAL — leave blank to use plaintext .env fallback)
# =====================
# Machine identity credentials from your Infisical project.
# Create a Machine Identity in Infisical → Settings → Machine Identities.
HDP_INFISICAL_URL=https://your-infisical-instance.example.com
HDP_INFISICAL_PROJECT_ID=
HDP_INFISICAL_CLIENT_ID=
HDP_INFISICAL_CLIENT_SECRET=
HDP_INFISICAL_ENV=prod

# =====================
# LLM Configuration
# =====================
# HDP_LLM_BASE_URL / HDP_LLM_MODEL are non-secret (endpoint + model name).
# HDP_LLM_API_KEY is a secret: set it here as a plaintext fallback, or
# (recommended) store it in Infisical as HDP_LLM_API_KEY and leave this blank.
#
# ⚠️ If you use Infisical: infisical-loader.sh fetches EVERY secret whose
# name starts with HDP_, not just credentials — so if HDP_LLM_BASE_URL or
# HDP_LLM_MODEL also exist as Infisical secrets, THEY WIN over the values
# below on every container start. Either keep these two as pure .env
# config (don't create matching Infisical secrets), or set them in both
# places consistently. This is the single most common source of "I changed
# .env but the container is still using the old provider" confusion.
#
# Any OpenAI-compatible chat completions endpoint works:
#   OpenAI:        https://api.openai.com/v1              model: gpt-4o
#   z.ai / GLM:     https://api.z.ai/api/coding/paas/v4     model: glm-4.5-air
#   Nebius:        https://api.studio.nebius.ai/v1         model: qwen-235b
HDP_LLM_BASE_URL=https://api.openai.com/v1
HDP_LLM_MODEL=gpt-4o
HDP_LLM_API_KEY=

# =====================
# Embedding Provider Configuration
# =====================
# Controls BOTH the live RAG pipeline's query-time embedder AND the
# ingest_hdp_wiki.py batch ingestion script's document embedder.
# Three modes — pick one via HDP_EMBEDDING_PROVIDER:
#
#   local (DEFAULT, zero extra config)
#     Runs sentence-transformers in-container on CPU (or GPU if
#     HAYSTACK_DEVICE=gpu). This is what upstream BlueSpice HDP ships with.
#     No other HDP_EMBEDDING_* variables needed — just leave them blank.
#
#   remote
#     Points the pipeline at any OpenAI-compatible embeddings API — e.g.
#     a self-hosted Text-Embeddings-Inference (TEI) server, or a commercial
#     embeddings API. Requires HDP_EMBEDDING_BASE_URL and HDP_EMBEDDING_MODEL;
#     HDP_EMBEDDING_API_KEY only if your endpoint requires auth.
#     Recommended for production once you have a dedicated GPU embedding
#     server — much faster than "local" on constrained hosts.
#
#   hf_space  (ingestion / testing ONLY — not usable in docker-compose here)
#     Embeds via a HuggingFace ZeroGPU Gradio Space through gradio_client.
#     Useful for a one-off fast bulk re-index (~75x faster than CPU) without
#     provisioning your own GPU. NOT valid for HDP_EMBEDDING_PROVIDER in this
#     .env — the live pipeline entrypoint rejects it (Spaces cold-start and
#     rate-limit unpredictably, unacceptable for live user queries). Instead,
#     run it as a one-off:
#       docker compose exec haystack python3 ingest_hdp_wiki.py --provider hf_space
#     with HDP_EMBEDDING_HF_SPACE_ID / HDP_EMBEDDING_HF_TOKEN set below (or
#     passed via -e on that exec command). See docs/embedding-providers.md
#     for how to deploy your own minimal embedding Space.
#
HDP_EMBEDDING_PROVIDER=local
HDP_EMBEDDING_MODEL=mixedbread-ai/deepset-mxbai-embed-de-large-v1
HDP_EMBEDDING_DIM=1024
# ⚠️ Same Infisical-shadowing caveat as HDP_LLM_* above applies here.

# Only used when HDP_EMBEDDING_PROVIDER=remote:
HDP_EMBEDDING_BASE_URL=
HDP_EMBEDDING_API_KEY=

# Only used when running ingest_hdp_wiki.py --provider hf_space manually:
HDP_EMBEDDING_HF_SPACE_ID=
HDP_EMBEDDING_HF_TOKEN=

# =====================
# Wiki Server (non-secret)
# =====================
MW_DOCKER_PORT=8080
MW_LANG=de
MW_SITENAME=BlueSpice HDP
# The base URL MediaWiki uses for all internal links and redirects.
# Default (http://localhost:<port>) works for single-user local testing.
# Set to the host IP or hostname if the wiki should be reachable from
# other machines in your LAN — otherwise logins and redirects will
# send browsers to their own localhost and fail.
#   Example: MW_SERVER=http://192.168.1.50:8080
#            MW_SERVER=https://wiki.example.com
MW_SERVER=http://localhost:8080

# FPM user: master starts as root (UID 0) to spawn www-data workers
MW_DOCKER_UID=0
MW_DOCKER_GID=0

# =====================
# Haystack (non-secret)
# =====================
HAYHOOKS_PORT=1416
HDP_PDF_PORT=1417
HAYSTACK_DEVICE=cpu

# =====================
# Container memory limits (optional — sensible defaults apply if unset)
# =====================
# Override any of these if your host has more/less RAM than the defaults
# assume, or if OpenSearch/haystack get OOM-killed under heavier load.
# (These are read directly by docker-compose.yml, not by the containers —
# so the Infisical-shadowing caveat above does NOT apply to these.)
# HDP_HAYSTACK_MEM_LIMIT=3g
# HDP_OPENSEARCH_MEM_LIMIT=1536m
# HDP_MARIADB_MEM_LIMIT=1g
# HDP_MEDIAWIKI_MEM_LIMIT=1g
# HDP_MEDIAWIKI_WEB_MEM_LIMIT=512m
# HDP_JOBRUNNER_MEM_LIMIT=512m
# HDP_CHATBOT_PROXY_MEM_LIMIT=256m

# =====================
# Database / Wiki / Search Secrets
# =====================
# Store these in Infisical (recommended), or set plaintext values here as
# a fallback. HDP_OPENSEARCH_PASSWORD in particular MUST be set here even
# if you use Infisical for everything else — Docker Compose needs it to
# create the OpenSearch container before any Infisical-aware process runs.
#
#   HDP_DB_ROOT_PASSWORD     — MariaDB root password
#   HDP_DB_PASSWORD          — MariaDB bluespice user password
#   HDP_ADMIN_PASSWORD       — Wiki admin account password
#                               (Minimum 10 characters — MediaWiki requirement)
#   HDP_OPENSEARCH_PASSWORD  — OpenSearch admin password
#                               (8+ chars, upper+lower+number+special char)
#                               ⚠️ OpenSearch ALSO runs a zxcvbn password-
#                               strength check beyond the character-class rules
#                               above. Common leetspeak patterns like
#                               "Adm1nPassw0rd!" will be REJECTED despite
#                               meeting all stated rules. Use a strong random
#                               password instead:
#                                 openssl rand -hex 16
HDP_DB_ROOT_PASSWORD=
HDP_DB_PASSWORD=
HDP_ADMIN_PASSWORD=
HDP_OPENSEARCH_PASSWORD=

# If using Infisical, create the secrets above via the dashboard, or the CLI:
#   infisical_set_secret "HDP_DB_ROOT_PASSWORD" "$(openssl rand -hex 16)"
#   infisical_set_secret "HDP_DB_PASSWORD" "$(openssl rand -hex 16)"
#   infisical_set_secret "HDP_ADMIN_PASSWORD" "$(openssl rand -hex 16)"
#   infisical_set_secret "HDP_OPENSEARCH_PASSWORD" "Hdp-$(openssl rand -hex 4)-26!"
#   infisical_set_secret "HDP_LLM_API_KEY" "sk-..."
